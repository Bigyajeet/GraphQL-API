{
  "name": "document-vault-graphql",
  "version": "1.0.0",
  "description": "A backend GraphQL service for organizing documents into collections",
  "main": "src/server.ts",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "gendb": "prisma migrate dev --name init && prisma generate",
    "migrate": "prisma migrate dev",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "sanity": "bun run lint && bun run typecheck && bun run test && bun run test:integration",
    "vercel-build": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "graphql": "^16.10.0",
    "graphql-yoga": "^5.13.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/node": "^22.13.4",
    "bun-types": "^1.2.3",
    "eslint": "^9.21.0",
    "prisma": "^6.4.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1"
  }
}
